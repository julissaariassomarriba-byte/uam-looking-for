roToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.4380;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuarios" target="t_historial"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205.0" y="250"/></Array></mxGeometry></mxCell><mxCell id="r9" value="&lt;b&gt;reclamacion_id&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;se devuelve en (máx. una)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_reclamaciones" target="t_devoluciones"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r10" value="&lt;b&gt;devuelto_por&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;personal que lo devuelve al dueño&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.1825;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.7072;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuarios" target="t_devoluciones"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1800" y="180"/><mxPoint x="1800" y="1247.0"/></Array></mxGeometry></mxCell><mxCell id="r11" value="&lt;b&gt;recibido_por&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;personal que lo recibe de vuelta&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2555;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.4730;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuarios" target="t_devoluciones"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="200"/><mxPoint x="1760" y="1195.0"/></Array></mxGeometry></mxCell><mxCell id="r12" value="&lt;b&gt;usuario_id&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;quien presenta la reclamación&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.3285;exitDx=0;exitDy=0;entryX=0.7576;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuarios" target="t_reclamaciones"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="220"/></Array></mxGeometry></mxCell><mxCell id="r13" value="&lt;b&gt;resuelto_por&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;personal que la resuelve (vacío si está pendiente o cancelada)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.6204;exitDx=0;exitDy=0;entryX=0.2727;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuarios" target="t_reclamaciones"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="300"/></Array></mxGeometry></mxCell><mxCell id="r14" value="&lt;b&gt;objeto_id&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;posible coincidencia (opcional)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_objetos" target="t_reportes_visitantes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r15" value="&lt;b&gt;actualizado_por&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7C&quot;&gt;personal que lo gestiona&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;strokeColor=#3A6EA5;strokeWidth=1.6;fontSize=11;fontColor=#1A6FB5;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3650;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7239;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuarios" target="t_reportes_visitantes"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="230"/><mxPoint x="20" y="1611.0"/></Array></mxGeometry></mxCell><mxCell id="titulo" value="&lt;b&gt;Base de datos · UAM Looking For v8.5&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6B7C&gt;SQLite · 7 tablas · 15 llaves foráneas · normalizada hasta 3FN · generado desde schema.sql&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1D2733;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="70" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;CHECK (valores permitidos)&lt;/b&gt;&lt;br&gt;usuarios.nombre: trim(nombre) &amp;lt;&amp;gt; ''&lt;br&gt;usuarios.cif: cif IS NULL OR (cif = trim(cif) AND cif &amp;lt;&amp;gt; '')&lt;br&gt;usuarios.correo: correo IS NULL OR (correo = trim(correo) AND correo LIKE _%@_%._%)&lt;br&gt;usuarios.telefono: telefono IS NULL OR trim(telefono) &amp;lt;&amp;gt; ''&lt;br&gt;usuarios.carrera: carrera IS NULL OR trim(carrera) &amp;lt;&amp;gt; ''&lt;br&gt;usuarios.rol: rol IN (Administrador, Encargado, Estudiante, Docente, Administrativo, Visitante)&lt;br&gt;usuarios.contrasena_hash: contrasena_hash IS NULL OR (length(contrasena_hash) &amp;gt;= 40 AND&lt;br&gt;instr(contrasena_hash, $) &amp;gt; 0 AND instr(contrasena_hash,  ) = 0)&lt;br&gt;usuarios.activo: activo IN (0, 1)&lt;br&gt;usuarios: rol &amp;lt;&amp;gt; Visitante OR contrasena_hash IS NULL&lt;br&gt;usuarios: contrasena_hash IS NULL OR (cif IS NOT NULL AND correo IS NOT NULL)&lt;br&gt;objetos.titulo: trim(titulo) &amp;lt;&amp;gt; ''&lt;br&gt;objetos.descripcion: trim(descripcion) &amp;lt;&amp;gt; ''&lt;br&gt;objetos.descripcion_publica: descripcion_publica IS NULL OR trim(descripcion_publica) &amp;lt;&amp;gt; ''&lt;br&gt;objetos.categoria: categoria IN (Electrónicos, Documentos/Carné, Ropa/Accesorios, Llaves,&lt;br&gt;Útiles/Libros, Otros)&lt;br&gt;objetos.lugar_encontrado: trim(lugar_encontrado) &amp;lt;&amp;gt; ''&lt;br&gt;objetos.ubicacion: ubicacion IN (Vida Estudiantil, Sala Docente, Edificio A)&lt;br&gt;objetos.fecha: date(fecha) IS fecha&lt;br&gt;objetos.hora: hora IS NULL OR strftime(%H:%M, hora) IS hora&lt;br&gt;objetos.estado: estado IN (Activo, En resguardo, En bodega, Entregado, Por recuperar, Recuperado,&lt;br&gt;Devuelto)&lt;br&gt;objetos.foto_publica: foto_publica IN (0, 1)&lt;br&gt;objetos.foto: foto IS NULL OR (length(foto) &amp;lt;= 307200 AND (substr(foto, 1,&lt;br&gt;3) = XFFD8FF OR (substr(foto, 1, 4) = X52494646 AND substr(foto, 9, 4) = X57454250)))&lt;br&gt;objetos: foto IS NOT NULL OR foto_publica = 0&lt;br&gt;objetos: reportado_por IS NULL OR reportado_por &amp;lt;&amp;gt; registrado_por&lt;br&gt;entregas.senas: trim(senas) &amp;lt;&amp;gt; ''&lt;br&gt;entregas.fecha_entrega: datetime(fecha_entrega) IS fecha_entrega&lt;br&gt;reclamaciones.descripcion: trim(descripcion) &amp;lt;&amp;gt; ''&lt;br&gt;reclamaciones.lugar_perdida: lugar_perdida IS NULL OR trim(lugar_perdida) &amp;lt;&amp;gt; ''&lt;br&gt;reclamaciones.fecha_perdida: fecha_perdida IS NULL OR date(fecha_perdida) IS fecha_perdida&lt;br&gt;reclamaciones.estado: estado IN (Pendiente, Aceptada, Rechazada, Cancelada)&lt;br&gt;reclamaciones.respuesta: respuesta IS NULL OR trim(respuesta) &amp;lt;&amp;gt; ''&lt;br&gt;reclamaciones.fecha_solicitud: datetime(fecha_solicitud) IS fecha_solicitud&lt;br&gt;reclamaciones.fecha_resolucion: fecha_resolucion IS NULL OR datetime(fecha_resolucion) IS&lt;br&gt;fecha_resolucion&lt;br&gt;reclamaciones: estado &amp;lt;&amp;gt; Pendiente OR (fecha_resolucion IS NULL AND resuelto_por IS NULL)&lt;br&gt;reclamaciones: estado NOT IN (Aceptada,&lt;br&gt;Rechazada) OR (fecha_resolucion IS NOT NULL AND resuelto_por IS NOT NULL)&lt;br&gt;reclamaciones: estado &amp;lt;&amp;gt; Cancelada OR (fecha_resolucion IS NOT NULL AND resuelto_por IS NULL)&lt;br&gt;reclamaciones: estado &amp;lt;&amp;gt; Rechazada OR respuesta IS NOT NULL&lt;br&gt;reclamaciones: fecha_resolucion IS NULL OR fecha_resolucion &amp;gt;= fecha_solicitud&lt;br&gt;reclamaciones: fecha_perdida IS NULL OR fecha_perdida &amp;lt;= date(fecha_solicitud)&lt;br&gt;devoluciones.fecha_recepcion: datetime(fecha_recepcion) IS fecha_recepcion&lt;br&gt;devoluciones.fecha_devolucion: fecha_devolucion IS NULL OR datetime(fecha_devolucion) IS&lt;br&gt;fecha_devolucion&lt;br&gt;devoluciones.observaciones: observaciones IS NULL OR trim(observaciones) &amp;lt;&amp;gt; ''&lt;br&gt;devoluciones: (devuelto_por IS NULL) = (fecha_devolucion IS NULL)&lt;br&gt;devoluciones: fecha_devolucion IS NULL OR fecha_devolucion &amp;gt;= fecha_recepcion&lt;br&gt;historial.accion: accion IN (Registro, Cambio de estado, Descripción pública, Cambio de ubicación,&lt;br&gt;Foto, Entrega, Reclamación, Reclamación aceptada, Reclamación rechazada, Reclamación cancelada,&lt;br&gt;Recuperación, Devolución)&lt;br&gt;historial.fecha_hora: datetime(fecha_hora) IS fecha_hora&lt;br&gt;historial: CASE accion WHEN Registro THEN estado_nuevo IS NOT NULL AND estado_nuevo IN (Activo,&lt;br&gt;En resguardo,&lt;br&gt;En bodega) WHEN Cambio de estado THEN estado_nuevo IS NOT NULL AND estado_nuevo IN (Activo,&lt;br&gt;En resguardo,&lt;br&gt;En bodega) WHEN Entrega THEN estado_nuevo IS Entregado WHEN Reclamación aceptada THEN&lt;br&gt;estado_nuevo IS Por recuperar WHEN Recuperación THEN estado_nuevo IS Recuperado WHEN Devolución&lt;br&gt;THEN estado_nuevo IS Devuelto ELSE estado_nuevo IS NULL END&lt;br&gt;reportes_visitantes.codigo: codigo GLOB&lt;br&gt;UAM-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]&lt;br&gt;reportes_visitantes.token_hash: length(token_hash) = 64 AND token_hash NOT GLOB *[^0-9a-f]*&lt;br&gt;reportes_visitantes.nombre: trim(nombre) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.telefono: trim(telefono) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.correo: correo IS NULL OR (correo = trim(correo) AND correo LIKE _%@_%._%)&lt;br&gt;reportes_visitantes.objeto_nombre: trim(objeto_nombre) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.categoria: categoria IN (Electrónicos, Documentos/Carné, Ropa/Accesorios,&lt;br&gt;Llaves, Útiles/Libros, Otros)&lt;br&gt;reportes_visitantes.descripcion: trim(descripcion) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.lugar_perdida: trim(lugar_perdida) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.fecha_perdida: date(fecha_perdida) IS fecha_perdida&lt;br&gt;reportes_visitantes.estado: estado IN (Pendiente, En revisión, Localizado, Resuelto, Cerrado)&lt;br&gt;reportes_visitantes.fecha_registro: datetime(fecha_registro) IS fecha_registro&lt;br&gt;reportes_visitantes.observaciones: observaciones IS NULL OR trim(observaciones) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.fecha_actualizacion: fecha_actualizacion IS NULL OR&lt;br&gt;datetime(fecha_actualizacion) IS fecha_actualizacion&lt;br&gt;reportes_visitantes.whatsapp_estado: whatsapp_estado IN (Pendiente, Enviada, Fallida,&lt;br&gt;No configurada)&lt;br&gt;reportes_visitantes.whatsapp_intentos: whatsapp_intentos &amp;gt;= 0&lt;br&gt;reportes_visitantes.whatsapp_fecha: whatsapp_fecha IS NULL OR datetime(whatsapp_fecha) IS&lt;br&gt;whatsapp_fecha&lt;br&gt;reportes_visitantes.whatsapp_detalle: whatsapp_detalle IS NULL OR trim(whatsapp_detalle) &amp;lt;&amp;gt; ''&lt;br&gt;reportes_visitantes.foto: length(foto) BETWEEN 1 AND 307200 AND (substr(foto, 1,&lt;br&gt;3) = XFFD8FF OR (substr(foto, 1, 4) = X52494646 AND substr(foto, 9, 4) = X57454250))&lt;br&gt;reportes_visitantes: fecha_perdida &amp;lt;= date(fecha_registro)&lt;br&gt;reportes_visitantes: (actualizado_por IS NULL) = (fecha_actualizacion IS NULL)&lt;br&gt;reportes_visitantes: fecha_actualizacion IS NULL OR fecha_actualizacion &amp;gt;= fecha_registro&lt;br&gt;reportes_visitantes: (whatsapp_estado = Pendiente) = (whatsapp_intentos = 0)&lt;br&gt;reportes_visitantes: whatsapp_intentos = 0 OR whatsapp_fecha IS NOT NULL&lt;br&gt;reportes_visitantes: whatsapp_estado &amp;lt;&amp;gt; Enviada OR whatsapp_detalle IS NOT NULL&lt;br&gt;&lt;br&gt;&lt;b&gt;Índices&lt;/b&gt;&lt;br&gt;entregas(retirado_por)&lt;br&gt;historial(objeto_id)&lt;br&gt;objetos(categoria)&lt;br&gt;objetos(estado)&lt;br&gt;objetos(fecha)&lt;br&gt;objetos(registrado_por)&lt;br&gt;reclamaciones(entrega_id)&lt;br&gt;reclamaciones(estado)&lt;br&gt;reclamaciones(usuario_id)&lt;br&gt;ÚNICO reclamaciones(entrega_id) WHERE estado = 'Aceptada'&lt;br&gt;ÚNICO reclamaciones(entrega_id, usuario_id) WHERE estado = 'Pendiente'&lt;br&gt;reportes_visitantes(estado)&lt;br&gt;UNIQUE: usuarios.cif, usuarios.correo (admiten NULL, no vacío), entregas.objeto_id, devoluciones.reclamacion_id,&lt;br&gt;reportes_visitantes.codigo y reportes_visitantes.token_hash&lt;br&gt;Triggers (25): hechos pasados no se modifican ni se borran; registrado_por, entregado_por, resuelto_por,&lt;br&gt;recibido_por y devuelto_por = personal activo; el estado del objeto lo fijan los hechos&lt;br&gt;(Entregado → Por recuperar → Recuperado → Devuelto); el historial de los hechos lo escriben los triggers;&lt;br&gt;reclamación: nueva = Pendiente, objeto Entregado, otra persona con cuenta; resuelta no cambia;&lt;br&gt;devolución: solo de una aceptada, momento 2 una sola vez; fechas en orden entre tablas;&lt;br&gt;reporte de visitante (v8.5): nace Pendiente, lo reportado no cambia, lo gestiona el personal activo,&lt;br&gt;los intentos de WhatsApp solo aumentan y no se borra.&lt;br&gt;Vista vista_devoluciones: devolución + reclamación + entrega original + objeto (sin repetir datos).&lt;br&gt;Todas las FK: ON DELETE RESTRICT · ON UPDATE RESTRICT · PRAGMA foreign_keys = ON en cada conexión&lt;br&gt;&lt;br&gt;&lt;b&gt;Cómo leer:&lt;/b&gt; PK llave primaria · &lt;font color=&quot;#1A6FB5&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#6B4FA3&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · ✓ tiene CHECK · || uno obligatorio · o| cero o uno · o&amp;lt; cero o muchos" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1D2733;fillColor=#F6F8FB;strokeColor=#D9E1EA;spacing=12;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="1830" width="1980" height="2028" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>