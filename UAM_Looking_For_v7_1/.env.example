# Plantilla de configuración de UAM Looking For v10.2.
# Cópiala con el nombre .env (en esta misma carpeta) y escribe tus valores. El .env nunca se sube a GitHub.

# ---- Administrador (entra por /admin) ----
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=escribe-aqui-una-clave-segura
ADMIN_NOMBRE=Administrador UAM
ADMIN_CORREO=admin@ejemplo.edu.ni

# ---- Sesiones ----
# Genera una al azar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=escribe-aqui-un-texto-largo-y-aleatorio
# COOKIE_SEGURA=1   (solo si el sitio abre siempre con https://)

# ---- Catálogo ----
# Días que un objeto entregado o devuelto sigue viéndose en el catálogo antes de ocultarse (de 3 a 7; por defecto 5).
DIAS_OCULTAR=5

# ---- Plazos de custodia (RF-16) ----
# Días que un objeto puede quedarse sin reclamar en la oficina (desde el hallazgo) y en bodega (desde que entró).
# Cuando faltan 3 días o menos, el sistema lo avisa al personal. VALORES PROVISIONALES: la oficina debe definirlos.
PLAZO_OFICINA_DIAS=30
PLAZO_BODEGA_DIAS=60

# ---- Guía rápida (RF-11) ----
# Horario de atención que ven los estudiantes en la guía. Escribe el horario oficial; si se deja vacío, no se muestra.
HORARIO_ATENCION=

# ---- Correo (RF-14, comprobante de entrega) ----
# Sin estos datos el comprobante se puede imprimir, pero no enviar por correo.
# Puerto 587 usa STARTTLS; 465 usa SSL. Con Gmail se usa una «contraseña de aplicación», no la normal.
SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=

# ---- Dirección pública del sitio (para el enlace del aviso de WhatsApp) ----
SITIO_URL=https://tu-usuario.pythonanywhere.com

# ---- WhatsApp Business Cloud API (opcional) ----
# Sin estos datos los reportes de visitantes se guardan igual y el aviso queda «No configurada».
# Cómo obtener cada valor: README.md, sección «WhatsApp».
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
WHATSAPP_DESTINO=
WHATSAPP_PLANTILLA=nuevo_reporte_visitante
WHATSAPP_IDIOMA=es
# WHATSAPP_VERSION=v22.0
